---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/layout/Navbar/index.astro';
import Footer from '../components/layout/Footer/index.astro';
import styles from '../styles/invite.module.css';

const WHATSAPP_LINK = 'https://chat.whatsapp.com/Hbm9wubODmw2ycWx5DTcMZ';
const INVITE_TEXT = [
  'Hola! Te invito a entrar a Nexo Digital 🚀',
  '',
  'Es una comunidad de WhatsApp para creadores del mundo digital:',
  'desarrolladores, diseñadores, editores, músicos, gamers, IA y más.',
  '',
  'Hay empleos, proyectos, recursos, eventos y networking.',
  'Gratis y sin spam. Te sumás acá:',
  WHATSAPP_LINK,
].join('\n');
---

<Layout
  title="Invitación — Nexo Digital"
  description="Te invitamos a Nexo Digital, la comunidad de WhatsApp para creadores del mundo digital. Entrá y conectá con otros profesionales."
>
  <Navbar />

  <main class={styles.page}>
    <div class={`container ${styles.card}`}>
      <img src="/logo.webp" alt="" width={72} height={72} class={styles.logo} />
      <p class={styles.eyebrow}>Invitación especial</p>
      <h1 class={styles.title}>
        Te invitamos a <span class="gradient-text">Nexo Digital</span>
      </h1>
      <p class={styles.text}>
        Una comunidad de WhatsApp para desarrolladores, diseñadores, editores, músicos,
        gamers y creadores del mundo digital. Conectá, compartí y crecé junto a otros talentos.
      </p>

      <div class={styles.qrBlock}>
        <img src="/qr-light.webp" alt="Código QR para unirse a Nexo Digital" width={160} height={160} class={styles.qr} />
        <span class={styles.qrLabel}>Escané para entrar</span>
      </div>

      <a href={WHATSAPP_LINK} class={styles.btn} target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Unirme al grupo de WhatsApp
      </a>
      <p class={styles.note}>Gratis · Sin spam · Solo tecnología y creatividad</p>

      <div class={styles.divider} aria-hidden="true"></div>

      <p class={styles.copyLabel}>¿Preferís reenviar una invitación?</p>
      <button type="button" id="copyInvite" class={styles.btnGhost} data-invite={INVITE_TEXT}>Copiar mensaje de invitación</button>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const copyBtn = document.getElementById('copyInvite');
  if (copyBtn) {
    const inviteText = copyBtn.getAttribute('data-invite') ?? '';
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(inviteText);
        const original = copyBtn.textContent;
        copyBtn.textContent = 'Copiado al portapapeles';
        setTimeout(() => { copyBtn.textContent = original; }, 2000);
      } catch {}
    });
  }
</script>