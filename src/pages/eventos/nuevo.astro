---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/layout/Navbar/index.astro';
import Footer from '../../components/layout/Footer/index.astro';
import logoImg from '../../assets/brand/logo.webp';
import { isAuthenticated } from '../../lib/roles';
import { submissionErrorMessage } from '../../lib/submission-errors';
import { EVENT_TYPES, EVENT_CATEGORIES } from '../../lib/portal-meta';
import styles from '../../styles/forms.module.css';

const user = Astro.locals.user;
if (!isAuthenticated(user)) {
  return Astro.redirect('/login?next=' + encodeURIComponent('/eventos/nuevo'), 303);
}

const errorCode = Astro.url.searchParams.get('error');
const fieldName = Astro.url.searchParams.get('field');
const errorMessage = submissionErrorMessage(errorCode);
const createdId = Astro.url.searchParams.get('id');
const justCreated = Astro.url.searchParams.get('created') === 'event';
---

<Layout
  title="Publicar evento — Nexo Digital"
  description="Publicá un evento en Nexo Digital. La revisaremos y lo publicaremos apenas esté aprobado."
>
  <Navbar />
  <main class={styles.page}>
    <div class={styles.card}>
      <header class={styles.header}>
        <h1 class={styles.title}>Publicar nuevo evento</h1>
        <p class={styles.subtitle}>
          Tu envío queda en revisión. Lo aprueba un moderador antes de salir al público.
        </p>
      </header>

      {errorMessage && (
        <p class={styles.error} role="alert">
          ⚠️ {errorMessage}
          {fieldName && <small> (campo: <code>{fieldName}</code>)</small>}
        </p>
      )}

      {justCreated && createdId && (
        <p class={styles.disclaimer}>
          ✅ Evento creado (id <code>{createdId.slice(0, 8)}</code>). Te avisamos cuando se apruebe.
        </p>
      )}

      <form method="POST" action="/api/eventos" enctype="multipart/form-data" class={styles.form} novalidate>
        <div class={styles.field}>
          <label class={styles.label} for="title">Título del evento <span class={styles.required}>*</span></label>
          <input class={styles.input} type="text" id="title" name="title" required minlength="4" maxlength="120" placeholder="Meetup de JavaScript" />
        </div>

        <div class={styles.field}>
          <label class={styles.label} for="description">Descripción <span class={styles.required}>*</span></label>
          <textarea class={styles.textarea} id="description" name="description" required minlength="20" maxlength="2000" placeholder="Contá de qué trata el evento, la agenda, los speakers…"></textarea>
        </div>

        <div class={styles.row}>
          <div class={styles.field}>
            <label class={styles.label}>Tipo de evento <span class={styles.required}>*</span></label>
            <div class={styles.pills} role="radiogroup" aria-label="Tipo de evento">
              {EVENT_TYPES.map((m) => (
                <label class={styles.pill}>
                  <input type="radio" name="event_type" value={m.value} required />
                  <span>{m.emoji} {m.label}</span>
                </label>
              ))}
            </div>
          </div>

          <div class={styles.field}>
            <label class={styles.label} for="category">Categoría <span class={styles.required}>*</span></label>
            <select class={styles.select} id="category" name="category" required>
              <option value="" disabled selected>Elegí…</option>
              {EVENT_CATEGORIES.map((c) => (
                <option value={c.value}>{c.emoji} {c.label}</option>
              ))}
            </select>
          </div>
        </div>

        <div class={styles.row}>
          <div class={styles.field}>
            <label class={styles.label} for="start_date">Fecha de inicio <span class={styles.required}>*</span></label>
            <input class={styles.input} type="date" id="start_date" name="start_date" required />
          </div>
          <div class={styles.field}>
            <label class={styles.label} for="end_date">Fecha de fin</label>
            <input class={styles.input} type="date" id="end_date" name="end_date" />
            <span class={styles.hint}>Opcional. Si dura un solo día, dejalo vacío.</span>
          </div>
        </div>

        <div class={styles.field}>
          <label class={styles.label} for="start_time">Horario</label>
          <input class={styles.input} type="time" id="start_time" name="start_time" />
          <span class={styles.hint}>Opcional. Ej: 18:00</span>
        </div>

        <div class={styles.field}>
          <label class={styles.label} for="location">Ubicación</label>
          <input class={styles.input} type="text" id="location" name="location" maxlength="200" placeholder="Ej: Palermo, CABA (para presenciales o híbridos)" />
          <span class={styles.hint}>Opcional. Para eventos presenciales o híbridos.</span>
        </div>

        <div class={styles.field}>
          <label class={styles.label} for="url">Link del evento</label>
          <input class={styles.input} type="url" id="url" name="url" maxlength="500" placeholder="https://meetup.com/..." />
          <span class={styles.hint}>Opcional. URL con más información o para inscripción.</span>
        </div>

        <div class={styles.field}>
          <label class={styles.label} for="contact_info">Contacto</label>
          <input class={styles.input} type="text" id="contact_info" name="contact_info" maxlength="200" placeholder="@usuario en redes o email" />
          <span class={styles.hint}>Opcional. Cómo contactarte o dónde seguir el evento.</span>
        </div>

        <div class={styles.field}>
          <label class={styles.label} for="max_participants">Cupo máximo</label>
          <input class={styles.input} type="number" id="max_participants" name="max_participants" min="0" step="1" placeholder="50" />
          <span class={styles.hint}>Opcional. Límite de participantes.</span>
        </div>

        <div class={styles.field}>
          <label class={styles.label} for="image">Imagen del evento</label>
          <input class={styles.input} type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp,image/gif" />
          <span class={styles.hint}>Opcional. Formatos JPG, PNG, WebP o GIF, hasta 2 MB. Se muestra como preview y se puede ver completa en grande.</span>
        </div>

        <div class={styles.field}>
          <label class={styles.label} for="cover_image">Foto de portada</label>
          <input class={styles.input} type="file" id="cover_image" name="cover_image" accept="image/jpeg,image/png,image/webp" />
          <span class={styles.hint}>Opcional. Tamaño determinado: 1200×630 px (16:9), JPG/PNG/WebP hasta 2 MB. Se muestra como banner en la card.</span>
          <button type="button" class={styles.cropOpen} id="crop-open" disabled>✂ Recortar de la imagen del evento</button>
          <span class={styles.hint} id="cover-chip" hidden>
            ✂ Portada generada por recorte, lista para enviar.
            <button type="button" class={styles.cropOpen} id="cover-chip-clear">Quitar recorte</button>
          </span>
        </div>

        <div class={styles.actions}>
          <button type="submit" class={styles.submit}>Enviar a revisión</button>
          <a href="/eventos" class={styles.cancel}>Cancelar</a>
        </div>
      </form>

      <div class={styles.cropOverlay} id="crop-overlay" hidden>
        <div class={styles.cropModal}>
          <h2 class={styles.cropTitle}>Recortar portada (16:9)</h2>
          <div class={styles.cropViewport} id="crop-viewport">
            <img id="crop-img" class={styles.cropImg} alt="" draggable="false" />
          </div>
          <label class={styles.label} for="crop-zoom">Zoom</label>
          <input type="range" id="crop-zoom" class={styles.cropZoom} min="1" max="4" step="0.05" value="1" />
          <div class={styles.actions}>
            <button type="button" class={styles.submit} id="crop-confirm">Usar recorte</button>
            <button type="button" class={styles.cancel} id="crop-cancel">Cancelar</button>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const form = document.querySelector('form');
  if (!form) throw new Error('Form not found');
  const key = 'form-draft:' + (form.getAttribute('action') || 'unknown');
  const hasError = new URLSearchParams(location.search).has('error');

  if (hasError) {
    const saved = sessionStorage.getItem(key);
    if (saved) {
      const data: Record<string, string> = JSON.parse(saved);
      for (const [name, value] of Object.entries(data)) {
        const el = form.elements.namedItem(name);
        if (!el) continue;
        if (el instanceof RadioNodeList) {
          for (const radio of el) {
            if (radio instanceof HTMLInputElement) radio.checked = radio.value === value;
          }
        } else if (el instanceof HTMLInputElement && el.type === 'checkbox') {
          (el as HTMLInputElement).checked = value === 'true';
        } else if (el instanceof HTMLSelectElement || el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) {
          el.value = value;
        }
      }
      sessionStorage.removeItem(key);
    }
  } else {
    sessionStorage.removeItem(key);
  }

  form.addEventListener('submit', () => {
    const fd = new FormData(form);
    const data: Record<string, string> = {};
    for (const [key, val] of fd.entries()) {
      if (typeof val === 'string') data[key] = val;
    }
    sessionStorage.setItem(key, JSON.stringify(data));
  });
</script>

<script>
  const imageInput = document.getElementById('image') as HTMLInputElement | null;
  const coverInput = document.getElementById('cover_image') as HTMLInputElement | null;
  const cropOpenBtn = document.getElementById('crop-open') as HTMLButtonElement | null;
  const cropOverlay = document.getElementById('crop-overlay') as HTMLDivElement | null;
  const cropViewport = document.getElementById('crop-viewport') as HTMLDivElement | null;
  const cropImgEl = document.getElementById('crop-img') as HTMLImageElement | null;
  const cropZoom = document.getElementById('crop-zoom') as HTMLInputElement | null;
  const cropConfirm = document.getElementById('crop-confirm') as HTMLButtonElement | null;
  const cropCancel = document.getElementById('crop-cancel') as HTMLButtonElement | null;
  const coverChip = document.getElementById('cover-chip') as HTMLSpanElement | null;
  const coverChipClear = document.getElementById('cover-chip-clear') as HTMLButtonElement | null;

  if (
    imageInput && coverInput && cropOpenBtn && cropOverlay && cropViewport &&
    cropImgEl && cropZoom && cropConfirm && cropCancel && coverChip && coverChipClear
  ) {
    const EXPORT_W = 1200;
    const EXPORT_H = 630;
    let natW = 0;
    let natH = 0;
    let viewW = 0;
    let viewH = 0;
    let zoom = 1;
    let offX = 0;
    let offY = 0;

    const fitScale = () => Math.max(viewW / natW, viewH / natH);

    const clamp = () => {
      const s = fitScale() * zoom;
      offX = Math.min(0, Math.max(viewW - natW * s, offX));
      offY = Math.min(0, Math.max(viewH - natH * s, offY));
    };

    const render = () => {
      const s = fitScale() * zoom;
      cropImgEl.style.transform = `translate(${offX}px, ${offY}px) scale(${s})`;
    };

    const releaseUrl = () => {
      if (cropImgEl.src.startsWith('blob:')) URL.revokeObjectURL(cropImgEl.src);
    };

    imageInput.addEventListener('change', () => {
      cropOpenBtn.disabled = !(imageInput.files && imageInput.files.length > 0);
    });

    coverInput.addEventListener('change', () => {
      coverChip.hidden = true;
    });

    cropOpenBtn.addEventListener('click', () => {
      const file = imageInput.files && imageInput.files[0];
      if (!file) return;
      releaseUrl();
      cropOverlay.hidden = false;
      cropImgEl.onload = () => {
        natW = cropImgEl.naturalWidth;
        natH = cropImgEl.naturalHeight;
        viewW = cropViewport.clientWidth;
        viewH = cropViewport.clientHeight;
        zoom = 1;
        cropZoom.value = '1';
        const s = fitScale();
        offX = (viewW - natW * s) / 2;
        offY = (viewH - natH * s) / 2;
        clamp();
        render();
      };
      cropImgEl.src = URL.createObjectURL(file);
    });

    cropZoom.addEventListener('input', () => {
      zoom = Number(cropZoom.value);
      clamp();
      render();
    });

    let panning = false;
    let panX = 0;
    let panY = 0;

    cropViewport.addEventListener('pointerdown', (e) => {
      panning = true;
      panX = e.clientX;
      panY = e.clientY;
      cropViewport.setPointerCapture(e.pointerId);
    });

    cropViewport.addEventListener('pointermove', (e) => {
      if (!panning) return;
      offX += e.clientX - panX;
      offY += e.clientY - panY;
      panX = e.clientX;
      panY = e.clientY;
      clamp();
      render();
    });

    const stopPan = () => { panning = false; };
    cropViewport.addEventListener('pointerup', stopPan);
    cropViewport.addEventListener('pointercancel', stopPan);

    cropCancel.addEventListener('click', () => {
      releaseUrl();
      cropOverlay.hidden = true;
    });

    cropOverlay.addEventListener('click', (e) => {
      if (e.target === cropOverlay) {
        releaseUrl();
        cropOverlay.hidden = true;
      }
    });

    cropConfirm.addEventListener('click', () => {
      const s = fitScale() * zoom;
      const canvas = document.createElement('canvas');
      canvas.width = EXPORT_W;
      canvas.height = EXPORT_H;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      ctx.drawImage(cropImgEl, -offX / s, -offY / s, viewW / s, viewH / s, 0, 0, EXPORT_W, EXPORT_H);
      canvas.toBlob((blob) => {
        if (!blob) return;
        const dt = new DataTransfer();
        dt.items.add(new File([blob], 'portada.jpg', { type: 'image/jpeg' }));
        coverInput.files = dt.files;
        coverChip.hidden = false;
        cropOverlay.hidden = true;
        releaseUrl();
      }, 'image/jpeg', 0.85);
    });

    coverChipClear.addEventListener('click', () => {
      coverInput.value = '';
      coverChip.hidden = true;
    });
  }
</script>
